# CrateCompass environment contract
# Copy to an ignored local environment file and fill values there.
# Never commit real credentials. Public variables are explicitly prefixed NEXT_PUBLIC_.

# Application
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
APP_ENV=development
LOG_LEVEL=info

# Supabase browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase privileged server-only configuration
# Use only in narrow trusted administrative code such as verified account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Spotify connected-account integration (server-only except the client ID where explicitly needed)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/spotify/callback

# Versioned 32-byte token-encryption key, encoded using the format selected in the encryption ADR.
# Generate securely during implementation; do not reuse application/provider secrets.
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_TOKEN_ENCRYPTION_KEY_VERSION=1

# MusicBrainz identification (server-only request configuration)
MUSICBRAINZ_APP_NAME=CrateCompass
MUSICBRAINZ_APP_VERSION=0.1.0
MUSICBRAINZ_CONTACT=

# Discovery provider
DISCOVERY_PROVIDER=lastfm
LASTFM_API_KEY=
# Optional only if ListenBrainz is approved/selected later.
LISTENBRAINZ_USER_TOKEN=

# AI provider abstraction
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Application security and abuse controls
# Exact implementation/store is selected in a later ADR; no insecure default is provided.
RATE_LIMIT_STORE_URL=
RATE_LIMIT_STORE_TOKEN=

