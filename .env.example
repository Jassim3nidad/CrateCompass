# CrateCompass environment contract
# Copy to an ignored local environment file and fill values there.
# Never commit real credentials. Public variables are explicitly prefixed NEXT_PUBLIC_.

# Application
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
APP_ENV=development
LOG_LEVEL=info

# Supabase browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase privileged server-only configuration
# Use only in narrow trusted administrative code such as verified account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Spotify connected-account integration (server-only except the client ID where explicitly needed)
SPOTIFY_CLIENT_ID=
# Unused. ADR 0002 selects Authorization Code with PKCE, which authenticates the
# token request with client_id and code_verifier and takes no client secret.
# Documented only so reversing that decision is a one-line change.
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/spotify/callback

# Versioned 32-byte token-encryption key, encoded using the format selected in the encryption ADR.
# Generate securely during implementation; do not reuse application/provider secrets.
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_TOKEN_ENCRYPTION_KEY_VERSION=1

# MusicBrainz identification (server-only request configuration)
# MUSICBRAINZ_CONTACT is REQUIRED: MusicBrainz mandates a User-Agent carrying a
# contact email or URL, and throttles requests that do not identify a maintainer.
MUSICBRAINZ_APP_NAME=CrateCompass
MUSICBRAINZ_APP_VERSION=0.1.0
MUSICBRAINZ_CONTACT=

# Discovery provider — ADR 0003 selected ListenBrainz.
DISCOVERY_PROVIDER=listenbrainz
# Optional. Reads work unauthenticated; a token may raise the rate limit.
LISTENBRAINZ_USER_TOKEN=
# Optional. Overrides the Labs similar-artists algorithm tuning string, which is
# opaque and may change upstream without notice.
LISTENBRAINZ_SIMILARITY_ALGORITHM=

# AI provider abstraction.
# All three adapters implement the same contract; AI_PROVIDER selects which one
# runs, and only the selected provider's key and model are required.
AI_PROVIDER=gemini

# Google AI Studio — the zero-cost option. Google's docs state "no billing setup
# necessary" for the free tier, and its OpenAI-compatible endpoint supports the
# JSON-schema constrained output this codebase requires.
# Get a key at https://aistudio.google.com/apikey (no card).
# Free-tier models include gemini-3.5-flash-lite, gemini-2.5-flash-lite,
# gemini-3.6-flash. Check current limits at https://aistudio.google.com/rate-limit
#
# TRADE-OFF: Google states free-tier content IS used to improve their products,
# unlike the paid tier. User-authored mood text and questions become training
# data. See ADR 0005 — this is a privacy-notice obligation, not a cost one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter routes to third-party models. The selected model MUST support
# structured outputs — every AI call here is schema-constrained. OpenRouter's
# free tier does not: no zero-priced model in its catalogue supports them.
# Cheapest viable options, roughly ascending: nex-agi/nex-n2-mini,
# google/gemini-3.1-flash-lite, qwen/qwen3.7-plus.
# See ADR 0004 for the added-subprocessor implications.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=

# Application security and abuse controls
# Exact implementation/store is selected in a later ADR; no insecure default is provided.
RATE_LIMIT_STORE_URL=
RATE_LIMIT_STORE_TOKEN=

# Automated testing only. Serves invented MusicBrainz and ListenBrainz data so
# the end-to-end suite can exercise discovery without calling a live provider.
# Playwright sets this for its own dev server; you should not need it locally.
# The environment schema REFUSES TO VALIDATE this as "1" unless APP_ENV=test,
# so a deployment carrying it will fail to start rather than serve fixtures.
PROVIDER_FIXTURES=

